# ── AI Provider Configuration ────────────────────────────────────────────────
# Production-grade multi-provider AI summarizer with weighted fallback routing.
# Providers are tried in priority order with smart cooldowns on failures.

# AI: keep Gemini OFF in India/China — region-blocked on free tier wastes 14.5s
# per cold call. Set to true only if hosting in a Gemini-eligible region.
AI_ENABLE_GEMINI=false
GEMINI_API_KEY=

# Groq: Fast, free, production-stable. Primary provider for speed.
# Sign up at https://console.groq.com → API Keys
GROQ_API_KEY=

# OpenRouter: Most stable provider with multiple free models.
# Sign up at https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# Cerebras: Free, 1M tokens/day, OpenAI-compatible, separate-vendor fallback.
# Sign up at https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=

# Cloudflare Workers AI: Free tier with fast inference.
# Get from Cloudflare Dashboard → AI → API Tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# NVIDIA NIM: Free tier for testing, production-grade models.
# Sign up at https://build.nvidia.com → API Keys
NVIDIA_API_KEY=
