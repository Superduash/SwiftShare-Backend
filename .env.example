# ── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swiftshare
FRONTEND_URL=https://your-frontend.vercel.app
SHARE_BASE_URL=https://your-frontend.vercel.app
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# ── Optional services (graceful if missing) ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=

# ── R2 / Storage tuning ────────────────────────────────────────────────────────
# Override the default R2 endpoint (auto-derived from R2_ACCOUNT_ID if not set)
R2_ENDPOINT=
# R2 region (default: auto)
R2_REGION=auto
# Keep-alive socket pool size for R2 connections (default: 50)
R2_KEEPALIVE_MAX_SOCKETS=50
# Connection timeout in ms (default: 8000)
R2_CONNECTION_TIMEOUT_MS=8000
# Socket timeout in ms (default: 120000)
R2_SOCKET_TIMEOUT_MS=120000
# Max retry attempts for R2 operations (default: 4)
R2_MAX_ATTEMPTS=4

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated extra origins; supports wildcard hosts like https://*.vercel.app
CORS_EXTRA_ORIGINS=
# Set to true only for temporary deployment diagnostics — never in production
CORS_ALLOW_ALL_ORIGINS=false

# ── Server tuning ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=warn

# ── Transfer limits ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
MAX_FILE_COUNT=10
SESSION_EXPIRY_MINUTES=10
MAX_SESSION_EXPIRY_MINUTES=1440
CODE_LENGTH=6

# ── Health check / caching ─────────────────────────────────────────────────────
HEALTH_CACHE_TTL_MS=15000
HEALTH_CHECK_TIMEOUT_MS=4000
STATS_CACHE_TTL_MS=30000

# ── Request timeouts ───────────────────────────────────────────────────────────
# Upload/download routes (ms). Render free tier needs longer timeouts.
UPLOAD_REQUEST_TIMEOUT_MS=180000
REQUEST_TIMEOUT_MS=90000

# ── Features ───────────────────────────────────────────────────────────────────
QR_BRANDED=true

# ── Self-ping (Render free tier keep-alive) ────────────────────────────────────
# Set to your Render external URL to keep the dyno awake during active sessions
RENDER_EXTERNAL_URL=https://your-backend.onrender.com
# Or use BACKEND_URL as an alias
BACKEND_URL=
