# ── Storage Configuration ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/swiftshare

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_REGION=auto
R2_ENDPOINT=

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
SHARE_BASE_URL=http://localhost:5173

# ── Redis Cache (Optional) ────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS Configuration ────────────────────────────────────────────────────────
CORS_EXTRA_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=false

# ── Monitoring (Optional) ─────────────────────────────────────────────────────
SENTRY_DSN=

# ── Performance & Limits ──────────────────────────────────────────────────────
HEALTH_CACHE_TTL_MS=15000
HEALTH_CHECK_TIMEOUT_MS=4000
BURN_IDLE_FINALIZE_MS=90000
SESSION_EXPIRY_MINUTES=10
MAX_SESSION_EXPIRY_MINUTES=300
MAX_FILE_SIZE_MB=100
MAX_FILE_COUNT=10

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
