{
  "watch": ["."],
  "ignore": ["*.log", "node_modules", ".git", "uploads", "temp", "coverage"],
  "ext": "js,json",
  "delay": 250,
  "signal": "SIGTERM",
  "exitcrash": true,
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "node -e \"console.log('\\n[hot-reload] Backend restarted\\n')\""
  }
}
